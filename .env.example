# ============================================================
# Shohay Backend Environment Variables
# Copy this file to .env for local development
# For Vercel deployment, configure these in Vercel Project Settings > Environment Variables
# ============================================================

# Supabase PostgreSQL Connection String
# Go to: Supabase Dashboard > Settings > Database > Connection String > URI
# IMPORTANT: For serverless (Vercel), use the "Transaction" pooler (port 6543)
# LOCAL DEVELOPMENT: leave SUPABASE_DB_URL empty and the app uses a SQLite file instead,
# created and filled with demo data automatically (no production access needed).
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Optional: where the local SQLite file lives (default: ./shohay_local.db)
# LOCAL_DB_URL=sqlite:///./shohay_local.db

# Supabase Project Credentials
# SUPABASE_URL is required to verify Supabase Auth sign-in tokens (via the project's public JWKS)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Auth roles
# Comma-separated emails that get the admin (District Coordinator) role on sign-in
ADMIN_EMAILS=coordinator@example.org
# Re-enables the unverified /api/auth/login and /api/auth/register/{public,fieldworker} endpoints (keep false in production)
ALLOW_LEGACY_AUTH=false

# Security & Environment
SECRET_KEY=change-me-to-a-secure-random-64-character-string
ENVIRONMENT=development

# Twilio Configuration (SMS OTP for Phone Login)
# Obtain from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Resend Configuration (Email OTP for Email Login)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL=Shohay Emergency <onboarding@resend.dev>

# Optional: Additional CORS origins (comma-separated)
ADDITIONAL_CORS_ORIGINS=
